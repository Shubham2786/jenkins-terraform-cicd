# ==============================================================================
# Example Terraform Configuration Variables
# Copy to terraform.tfvars and customize before running terraform plan / apply
# NOTE: Do NOT commit terraform.tfvars containing real credentials or secrets!
# ==============================================================================

aws_region         = "eu-west-1"
project_name       = "devops-cicd-dashboard"
environment        = "production"

# Network Configuration
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "eu-west-1a"

# Security Configuration
# IMPORTANT: Replace 0.0.0.0/0 with your actual workstation public IP (e.g. 203.0.113.50/32)
ssh_allowed_cidr   = "0.0.0.0/0"
app_port           = 3000

# Compute Configuration
ami_id             = "ami-0aacd9f2ec3771e2f" # Ubuntu AMI ID
instance_type      = "t2.micro"
key_name           = "devops-ec2-key" # Existing AWS KeyPair name for SSH access
root_volume_size   = 20

